def subset_sum(nums, target):
    result = []

    def backtrack(i, current, total):
        if total == target:
            result.append(current.copy())
            return

        if i == len(nums) or total > target:
            return

        current.append(nums[i])
        backtrack(i + 1, current, total + nums[i])
        current.pop()

        backtrack(i + 1, current, total)

    backtrack(0, [], 0)
    return result

