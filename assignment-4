class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


# Cycle detection function
def has_cycle(head):
    slow = head
    fast = head

    while fast and fast.next:
        slow = slow.next
        fast = fast.next.next

        if slow == fast:
            return True

    return False


# Create linked list
head = Node(10)
head.next = Node(20)
head.next.next = Node(30)
head.next.next.next = Node(40)

# Create a cycle
head.next.next.next.next = head.next


# Check cycle
if has_cycle(head):
    print("Cycle detected")
else:
    print("No cycle")













# Minimum Spanning Tree using Kruskal's Algorithm

def find(parent, i):
    if parent[i] == i:
        return i
    return find(parent, parent[i])


def union(parent, rank, x, y):
    xroot = find(parent, x)
    yroot = find(parent, y)

    if rank[xroot] < rank[yroot]:
        parent[xroot] = yroot
    elif rank[xroot] > rank[yroot]:
        parent[yroot] = xroot
    else:
        parent[yroot] = xroot
        rank[xroot] += 1


# Number of vertices
V = 4

# Edges: (weight, vertex1, vertex2)
edges = [
    (10, 0, 1),
    (6, 0, 2),
    (5, 0, 3),
    (15, 1, 3),
    (4, 2, 3)
]

# Sort edges by weight
edges.sort()

parent = []
rank = []

for i in range(V):
    parent.append(i)
    rank.append(0)

mst = []
total = 0

for weight, u, v in edges:
    x = find(parent, u)
    y = find(parent, v)

    if x != y:
        mst.append((u, v, weight))
        total += weight
        union(parent, rank, x, y)

# Print MST
print("Minimum Spanning Tree:")

for u, v, weight in mst:
    print(u, "-", v, "=", weight)

print("Total weight =", total)
